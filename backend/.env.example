# ==============================================
# SupoClip Backend Configuration
# Native macOS Version (parakeet-mlx + SQLite)
# ==============================================

# ==============================================
# Transcription (parakeet-mlx - Offline)
# ==============================================

# parakeet-mlx model identifier
# Default: mlx-community/parakeet-tdt-0.6b-v2
# Recommended: parakeet-tdt-0.6b-v2 for speed/accuracy balance
PARAKEET_MODEL=mlx-community/parakeet-tdt-0.6b-v2

# ==============================================
# LLM Configuration (Local-First)
# ==============================================

# Local LLM (Default - No API Key Required)
# Recommended: Run koboldcpp locally for offline operation
# Install: brew install koboldcpp
# Start:   koboldcpp --port 6969 --model /path/to/model.gguf --contextsize 4096
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://localhost:6969/v1
LOCAL_LLM_MODEL=local-model
LOCAL_LLM_API_KEY=not-needed

# Cloud LLM (Optional Fallback)
# Set LOCAL_LLM_ENABLED=false to use cloud APIs
# Choose one provider and set corresponding API key:
GROQ_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Cloud LLM model (only used if LOCAL_LLM_ENABLED=false)
# Format: "provider:model-name"
# Examples:
#   - groq:llama-3.3-70b-versatile                   (RECOMMENDED: Best for structured outputs, versatile)
#   - groq:llama-3.1-8b-instant                      (Faster, smaller model)
#   - groq:meta-llama/llama-4-scout-17b-16e-instruct (Experimental: May have issues with tool calling)
#   - openai:gpt-4o                                  (OpenAI's latest)
#   - anthropic:claude-3-5-sonnet                    (Anthropic's Claude)
#   - google:gemini-2.5-flash                        (Google's Gemini)
LLM_MODEL=groq:llama-3.3-70b-versatile

# ==============================================
# Database (SQLite - Local)
# ==============================================

# SQLite database file (uses aiosqlite driver)
# Path relative to backend directory
DATABASE_URL=sqlite+aiosqlite:///./supoclip.db

# ==============================================
# Job Queue Configuration (Local Async)
# ==============================================

# Maximum concurrent workers for video processing
MAX_WORKERS=2

# Worker timeout (seconds)
WORKER_TIMEOUT=3600

# ==============================================
# Video Processing
# ==============================================

# Maximum video duration to accept (seconds)
MAX_VIDEO_DURATION=3600

# Maximum clips to generate per video
MAX_CLIPS=10

# Default clip duration (seconds)
CLIP_DURATION=30

# Temporary directory for video files
TEMP_DIR=./temp

# Output directory for generated clips
OUTPUT_DIR=./outputs

# ==============================================
# Authentication (Local Development)
# ==============================================

# Disable authentication for local development (no sign-in required)
# Set to "true" to use local development mode with mock user
# Set to "false" for production (requires proper authentication)
DISABLE_AUTH=true

# Default user ID to use when authentication is disabled
# Only used if DISABLE_AUTH=true
DEFAULT_USER_ID=local-user

# ==============================================
# Backend Server Configuration
# ==============================================

# Backend URL for generating full clip URLs (used by frontend for downloads)
# Update this if running backend on a different port
BACKEND_URL=http://localhost:8008
