# SupoClip Environment Configuration
# Native macOS Version (MLX + SQLite + Local Queue)
# Copy to .env and update with your preferences

# ==============================================
# Transcription Configuration
# ==============================================

# MLX Whisper model size for local transcription
# Options: tiny, base, small, medium, large
# Recommended: medium (good balance of speed/accuracy)
MLX_WHISPER_MODEL=medium

# ==============================================
# AI Provider API Keys (Optional)
# ==============================================

# For transcript analysis, choose one provider:

# OpenAI (recommended for quality)
OPENAI_API_KEY=

# Google AI / Gemini
GOOGLE_API_KEY=

# Anthropic / Claude
ANTHROPIC_API_KEY=

# ==============================================
# AI Model Configuration
# ==============================================

# Format: "provider:model-name"
# Examples:
#   - openai:gpt-4.1
#   - openai:gpt-4o
#   - anthropic:claude-3-5-sonnet
#   - google:gemini-2.5-flash
LLM_MODEL=google:gemini-2.5-flash

# ==============================================
# Authentication
# ==============================================

# Better Auth secret for session management
# Generate a secure random string for production
BETTER_AUTH_SECRET=supoclip_dev_secret_change_in_production

# Better Auth URL
BETTER_AUTH_URL=http://localhost:3000

# ==============================================
# Database Configuration
# ==============================================

# SQLite database file path (relative to backend/)
# Uses local SQLite instead of PostgreSQL
DATABASE_URL=file:./supoclip.db

# ==============================================
# Backend Configuration
# ==============================================

# Backend API URL for frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local job queue settings
MAX_WORKERS=2
WORKER_TIMEOUT=3600

# ==============================================
# Video Processing
# ==============================================

# Maximum video duration (seconds)
MAX_VIDEO_DURATION=3600

# Maximum clips to generate per video
MAX_CLIPS=10

# Default clip duration (seconds)
CLIP_DURATION=30

# Temporary directory for video processing
TEMP_DIR=./temp
