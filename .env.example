# SupoClip Environment Configuration
# Native macOS Version (MLX + SQLite + Local Queue)
# Copy to .env and update with your preferences

# ==============================================
# Transcription Configuration
# ==============================================

# parakeet-mlx model identifier for local transcription
# Default: mlx-community/parakeet-tdt-0.6b-v2
# Recommended: v2 or v3 for good speed/accuracy balance
PARAKEET_MODEL=mlx-community/parakeet-tdt-0.6b-v2

# ==============================================
# LLM Configuration (Local-First)
# ==============================================

# Local LLM (Default - No API Key Required)
# Recommended: Run koboldcpp locally for offline operation
# Install: brew install koboldcpp
# Start:   koboldcpp --port 6969 --model /path/to/model.gguf --contextsize 4096
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://localhost:6969/v1
LOCAL_LLM_MODEL=local-model
LOCAL_LLM_API_KEY=not-needed

# Cloud LLM (Optional Fallback)
# Set LOCAL_LLM_ENABLED=false to use cloud APIs
# Choose one provider and set corresponding API key:

# OpenAI (recommended for quality)
OPENAI_API_KEY=

# Google AI / Gemini
GOOGLE_API_KEY=

# Anthropic / Claude
ANTHROPIC_API_KEY=

# Cloud LLM model (only used if LOCAL_LLM_ENABLED=false)
# Format: "provider:model-name"
# Examples:
#   - openai:gpt-4.1
#   - openai:gpt-4o
#   - anthropic:claude-3-5-sonnet
#   - google:gemini-2.5-flash
LLM_MODEL=google:gemini-2.5-flash

# ==============================================
# Authentication (Local Development)
# ==============================================

# Disable authentication for local development (no sign-in required)
# Set to "true" to use local development mode with mock user
# Set to "false" for production (requires proper authentication)
DISABLE_AUTH=true

# Default user ID to use when authentication is disabled
# Only used if DISABLE_AUTH=true
DEFAULT_USER_ID=local-user

# Better Auth secret for session management (production only)
# Generate a secure random string for production
BETTER_AUTH_SECRET=supoclip_dev_secret_change_in_production

# Better Auth URL (production only)
BETTER_AUTH_URL=http://localhost:3003

# ==============================================
# Database Configuration
# ==============================================

# SQLite database file path (relative to backend/)
# Uses local SQLite instead of PostgreSQL
DATABASE_URL=file:./supoclip.db

# ==============================================
# Backend Configuration
# ==============================================

# Backend API URL for frontend
NEXT_PUBLIC_API_URL=http://localhost:8008

# Local job queue settings
MAX_WORKERS=2
WORKER_TIMEOUT=3600

# ==============================================
# Video Processing
# ==============================================

# Maximum video duration (seconds)
MAX_VIDEO_DURATION=3600

# Maximum clips to generate per video
MAX_CLIPS=10

# Default clip duration (seconds)
CLIP_DURATION=30

# Temporary directory for video processing
TEMP_DIR=./temp
